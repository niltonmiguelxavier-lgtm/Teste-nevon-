# ---------------------------------------------------------------- Base de dados
# PostgreSQL (Supabase) — usar o pooler. O schema `express` é o único usado.
DATABASE_URL="postgresql://express_app.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_POOL_MAX=5

# ------------------------------------------------------------------- Aplicação
NEXT_PUBLIC_APP_URL="https://express-delivery.vercel.app"
SESSION_SECRET="gerar-com-openssl-rand-hex-32"

# ------------------------------------------------------- Nevon Pay (sandbox)
# Chave de API fornecida pelo proprietário. NUNCA exposta ao browser.
# nv_test_... = sandbox | nv_live_... = produção (a API recusa live no sandbox)
NEVONPAY_SECRET_KEY="nv_test_..."
NEVONPAY_BASE_URL="https://nevon-pay.vercel.app"
NEVONPAY_TIMEOUT_MS=15000
# Opcional: a documentação pública não descreve webhooks. Se a Nevon Pay fornecer
# um segredo HMAC, defina-o aqui para validar a assinatura dos webhooks.
NEVONPAY_WEBHOOK_SECRET=""
